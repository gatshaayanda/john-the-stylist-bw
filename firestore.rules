rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && (
          (
            request.auth.token.email_verified == true
            && request.auth.token.email in ['gatshaayanda@gmail.com', 'chikohoraknowledge4@gmail.com']
          )
          || (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'staff', 'Owner', 'Staff']
          )
        );
    }

    function validOrder() {
      // Every customer order must belong to a Firebase Auth session. Guests use Anonymous Auth; this is still authentication, not a sign-in requirement.
      return request.resource.data.keys().hasOnly([
          'customerId',
          'createdAt',
          'customerName',
          'phone',
          'mode',
          'scheduledFor',
          'deliveryLocation',
          'instructions',
          'items',
          'total',
          'status'
        ])
        && request.resource.data.keys().hasAll([
          'createdAt',
          'customerName',
          'phone',
          'mode',
          'scheduledFor',
          'deliveryLocation',
          'instructions',
          'items',
          'total',
          'status'
        ])
        && request.resource.data.createdAt is string
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.mode in ['pickup', 'delivery']
        && request.resource.data.scheduledFor is string
        && request.resource.data.deliveryLocation is string
        && request.resource.data.instructions is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'New'
        && (
          !request.resource.data.keys().hasAny(['customerId'])
          || request.resource.data.customerId is string
        );
    }

    function validCustomer(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'phone',
          'preferredDeliveryLocation',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.preferredDeliveryLocation is string
        && request.resource.data.notes is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function validReconciliation() {
      return request.resource.data.keys().hasOnly([
        'date',
        'actualCash',
        'actualETransfer',
        'actualOther',
        'notes',
        'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'date',
        'actualCash',
        'actualETransfer',
        'actualOther',
        'notes',
        'updatedAt'
      ])
      && request.resource.data.date is string
      && request.resource.data.actualCash is number
      && request.resource.data.actualCash >= 0
      && request.resource.data.actualETransfer is number
      && request.resource.data.actualETransfer >= 0
      && request.resource.data.actualOther is number
      && request.resource.data.actualOther >= 0
      && request.resource.data.notes is string
      && request.resource.data.updatedAt is string;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /customers/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validCustomer(uid);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if validOrder()
        && request.resource.data.keys().hasAll(['customerId'])
        && isOwner(request.resource.data.customerId);

      allow read: if isAdmin()
        || (
          resource.data.keys().hasAny(['customerId'])
          && isOwner(resource.data.customerId)
        );

      allow update, delete: if isAdmin();
    }

    match /appointmentAvailability/{dateId} {
      // Customers need to read date closures to choose an available day. Only authorized staff can change them.
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['date', 'available', 'reason', 'updatedAt'])
        && request.resource.data.keys().hasAll(['date', 'available', 'reason', 'updatedAt'])
        && request.resource.data.date == dateId
        && request.resource.data.available == false
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 120
        && request.resource.data.updatedAt is string;
      allow delete: if isAdmin();
    }

    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businessSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notificationPreferences/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['enabled','leadMinutes','updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.leadMinutes in [5,10,15,20,30,45,60]
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(uid);
    }

    match /notificationTokens/{uid}/tokens/{tokenId} {
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['token','admin','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.admin is bool
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(uid);
      allow read: if false;
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.lastMessageAt is string
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.unreadForCustomer is bool
        && request.resource.data.unreadForAdmin is bool;
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessageAt','lastMessagePreview','unreadForCustomer','unreadForAdmin','customerLastReadAt']));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole in ['customer','admin']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is string
          && (
            (request.resource.data.senderRole == 'customer' && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid)
            || (request.resource.data.senderRole == 'admin' && isAdmin())
          );
        allow update, delete: if false;
      }
    }

    match /styleFeed/{postId} {
      // Customers may only read published style posts. Owner/staff can see drafts and manage publishing.
      allow read: if isAdmin() || resource.data.published == true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title','caption','imageUrl','service','tags','published','createdAt','createdAtServer','createdBy'])
        && request.resource.data.keys().hasAll(['title','caption','imageUrl','service','tags','published','createdAt','createdBy'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 700
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.service is string
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 8
        && request.resource.data.published is bool
        && request.resource.data.createdAt is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','caption','imageUrl','service','tags','published','updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 700
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.service is string
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 8
        && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }


    match /customerStyleReviews/{reviewId} {
      function validCustomerStyleReview() {
        return request.resource.data.keys().hasOnly([
            'customerId', 'customerName', 'title', 'caption', 'imageUrl', 'imageKey',
            'service', 'rating', 'comparison', 'previousReviewId', 'createdAt',
            'published', 'status'
          ])
          && request.resource.data.keys().hasAll([
            'customerId', 'customerName', 'title', 'caption', 'imageUrl', 'imageKey',
            'service', 'rating', 'comparison', 'previousReviewId', 'createdAt',
            'published', 'status'
          ])
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() <= 60
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.caption is string
          && request.resource.data.caption.size() > 0
          && request.resource.data.caption.size() <= 700
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.matches('https://.*')
          && request.resource.data.imageKey is string
          && request.resource.data.imageKey.size() > 0
          && request.resource.data.service is string
          && request.resource.data.service.size() <= 80
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comparison in ['first', 'happier', 'same', 'less-happy']
          && request.resource.data.previousReviewId is string
          && request.resource.data.createdAt is string
          && request.resource.data.published == true
          && request.resource.data.status == 'published';
      }

      allow create: if signedIn() && !isAdmin() && validCustomerStyleReview();
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || resource.data.published == true;
      // Customers' reviews are an immutable history. Owner/staff can moderate, edit, or remove them.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerName', 'title', 'caption', 'imageUrl', 'imageKey', 'service',
          'rating', 'comparison', 'published', 'status', 'moderatedAt', 'moderatedBy'
        ])
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /dailyReconciliations/{date} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validReconciliation();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}